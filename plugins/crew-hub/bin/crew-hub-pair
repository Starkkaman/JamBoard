#!/usr/bin/env python3
"""Pair this machine with the Home Assistant Crew Hub. Run it yourself in a terminal (not through Claude): it reads a
pairing code or MQTT login without echoing it. See lib/crewhub/pair.py and docs/WEBHOOK.md."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from crewhub.pair import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
