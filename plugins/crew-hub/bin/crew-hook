#!/usr/bin/env python3
"""Crew Hub hook entry point (every hook event). Prints nothing and always exits 0. See lib/crewhub/hook.py."""
import os
import sys

try:
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
    from crewhub.hook import main
except BaseException:
    os._exit(0)
main()
